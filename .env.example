# AgenTeX — environment configuration (example)
#
# Copy to `.env` and fill in the values:  cp .env.example .env
# `.env` is gitignored — never commit real secrets.


# ─── Target under test ────────────────────────────────────────────────────────
QA_TARGET_URL=https://example.com


# ─── Integrations (integration/ catalog) ─────────────────────────────────────
# Referenced BY NAME from integration/*_api.json / *_db.json — the catalog files
# hold env-var names, the values live here (or in your shell).
API_BASE_URL=https://jsonplaceholder.typicode.com
# Bearer token for the catalog's `tokenEnv` (see integration/*_api.json — default name
# API_TOKEN). Export it in your shell; it is NEVER stored in .env or passed on the
# command line. macOS/Linux/WSL/Git Bash: add to ~/.zshrc or ~/.bashrc. Native Windows
# (PowerShell/cmd): [Environment]::SetEnvironmentVariable("API_TOKEN","...","User")
# — see README's "One-time setup" > Secrets for details.
#   export API_TOKEN=...
# SQL Server via sqlcmd. Password goes in SQLCMDPASSWORD (sqlcmd reads it natively) —
# export it in your shell; it is NEVER passed on the command line.
DB_SERVER=
# Leave DB_PORT empty for the default (1433).
DB_PORT=
DB_NAME=
DB_USER=


# ─── Azure DevOps ─────────────────────────────────────────────────────────────
# Used by the task-estimation, test-design, and bug-report-azure skills (az boards / az devops).
AZURE_URL=https://dev.azure.com/your-org
AZURE_PROJECT=your-project
AZURE_TEAM=your-team
# Bug assignee options for bug-report-azure (comma-separated for several — always asked at runtime).
AZURE_ASSIGNEE=qa.engineer@example.com
# PAT for non-interactive auth. The azure-devops extension reads it from the env var
# AZURE_DEVOPS_EXT_PAT — export it in your shell (the agent never prints or passes the PAT):
#   export AZURE_DEVOPS_EXT_PAT="$AZURE_PAT"
AZURE_PAT=

# bug-report-azure — optional; anything left blank is asked at runtime or inherited from the
# parent User Story. None of these are ever silently guessed.
AZURE_AREA_PATH=
AZURE_ITERATION_PATH=
# Reference Bug whose template/layout new bugs mirror.
AZURE_BUG_TEMPLATE_ID=
# Related Test Plan a failed test case belongs to.
AZURE_TEST_PLAN_ID=
# Custom.* fields — only if your ADO process defines them.
AZURE_ENVIRONMENT=
AZURE_BUG_CATEGORY=
# Defaults: value area "Business", API version 7.1 — override only if your org needs it.
AZURE_VALUE_AREA=
AZURE_API_VERSION=


# ─── KB Ask API (ask-kb skill) ────────────────────────────────────────────────
# KB Ask API host (no auth — host only). Used by the ask-kb skill.
KB_ASK_BASE_URL=http://localhost:3000
# Default KB project id (acme-store, demo-shop, ...). A kb:<project>: step overrides it.
KB_PROJECT=acme-store
# Org slug sent with each KB Ask request. Leave blank unless your KB server expects one.
KB_ORG=
# Shared secret sent as x-api-key (required when the server has it set). Ask ops for the key.
KB_ASK_API_KEY=
