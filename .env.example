# AgenTeX — secrets (example)
#
# Copy to `.env` and fill in the values:  cp .env.example .env
# `.env` is gitignored — never commit real secrets.
#
# ONLY secrets live here. Non-secret configuration lives in `config/project.json`
# (project settings) and `environments/<env>.json` (per-environment data) — those
# files reference these variables BY NAME via { "envSecret": "<NAME>" }.

# Azure DevOps PAT. The bundled tracker scripts (bug filing, test-plan updates) read it
# from this file directly and send it only in the Authorization header — never printed,
# logged, or placed on a command line.
# The /estimate-story and /design-test flows still drive the `az` CLI: for those, also
# export it in your shell as AZURE_DEVOPS_EXT_PAT:
#   export AZURE_DEVOPS_EXT_PAT="$AZURE_PAT"
AZURE_PAT=

# SQL Server password — read natively by sqlcmd from the env; never on a command line.
SQLCMDPASSWORD=

# Bearer token for cataloged api: requests.
API_TOKEN=

# KB Ask shared secret, sent as x-api-key (required when the server has it set).
KB_ASK_API_KEY=

# Figma personal access token for ui-check: design baselines — sent as the
# X-Figma-Token header by the bundled runner; never printed or logged.
FIGMA_TOKEN=
