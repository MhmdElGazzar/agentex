{
  "version": "1.0",
  "groups": {
    "project": {
      "label": "المشروع",
      "labelEn": "Project"
    },
    "environment": {
      "label": "البيئات",
      "labelEn": "Environments"
    }
  },
  "steps": [
    {
      "id": "project-basics",
      "title": "بيانات المشروع",
      "titleEn": "Project Basics",
      "description": "المعلومات الأساسية عن مشروعك",
      "descriptionEn": "Core information about your project",
      "icon": "🏗️",
      "group": "project",
      "target": "config/project.json",
      "fields": [
        {
          "key": "name",
          "label": "اسم المشروع",
          "labelEn": "Project Name",
          "type": "text",
          "placeholder": "my-app",
          "required": true,
          "aiHint": "project name or system name"
        },
        {
          "key": "login.mode",
          "label": "نمط تسجيل الدخول",
          "labelEn": "Login Mode",
          "type": "select",
          "required": true,
          "default": "session",
          "options": [
            {
              "value": "session",
              "label": "Session (موصى به — مرة واحدة لكل جلسة)"
            },
            {
              "value": "per-test",
              "label": "Per-Test (تسجيل دخول في كل اختبار)"
            }
          ],
          "aiHint": "login strategy: session-based or per-test"
        }
      ]
    },
    {
      "id": "azure-devops",
      "title": "Azure DevOps",
      "titleEn": "Azure DevOps",
      "description": "إعدادات ربط Azure DevOps لإنشاء الـ bugs والـ test plans",
      "descriptionEn": "Azure DevOps settings for bug filing and test plans",
      "icon": "☁️",
      "group": "project",
      "target": "config/project.json",
      "optional": true,
      "fields": [
        {
          "key": "azure.org",
          "label": "Organization",
          "labelEn": "Organization",
          "type": "text",
          "placeholder": "my-org",
          "required": false,
          "aiHint": "Azure DevOps organization name"
        },
        {
          "key": "azure.project",
          "label": "Project",
          "labelEn": "Project",
          "type": "text",
          "placeholder": "My Project",
          "required": false,
          "aiHint": "Azure DevOps project name"
        },
        {
          "key": "azure.team",
          "label": "Team",
          "labelEn": "Team",
          "type": "text",
          "placeholder": "My Team",
          "required": false,
          "aiHint": "Azure DevOps team name"
        },
        {
          "key": "azure.assignee",
          "label": "المسؤول الافتراضي",
          "labelEn": "Default Assignee",
          "type": "email",
          "placeholder": "qa@example.com",
          "required": false,
          "aiHint": "default assignee email for bugs"
        },
        {
          "key": "azure.pat",
          "label": "Azure DevOps PAT Token",
          "type": "password",
          "placeholder": "Personal Access Token من dev.azure.com",
          "required": false,
          "secret": true,
          "envKey": "AZURE_PAT",
          "aiHint": "Azure DevOps personal access token"
        }
      ]
    },
    {
      "id": "figma",
      "title": "Figma",
      "titleEn": "Figma",
      "description": "إعدادات Figma لخطوات ui-check (مقارنة الصفحة بالتصميم)",
      "descriptionEn": "Figma settings for ui-check: design-conformance steps",
      "icon": "🎨",
      "group": "project",
      "target": "config/project.json",
      "optional": true,
      "fields": [
        {
          "key": "figma.fileKey",
          "label": "File Key",
          "labelEn": "File Key",
          "type": "text",
          "placeholder": "AbCdEf123456",
          "required": false,
          "hint": "مفتاح ملف Figma من الرابط: figma.com/design/<FILE KEY>/...",
          "aiHint": "Figma file key (the path segment after /design/ or /file/ in a Figma URL)"
        },
        {
          "key": "figma.tokenEnvVar",
          "label": "متغير الـ Token",
          "labelEn": "Token Env Var",
          "type": "text",
          "placeholder": "FIGMA_TOKEN",
          "default": "FIGMA_TOKEN",
          "required": false,
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "patternMsg": "اسم متغير بيئة صالح فقط: حروف إنجليزية وأرقام و _ بدون مسافات",
          "aiHint": "environment variable name for the Figma personal access token"
        },
        {
          "key": "figma.token",
          "label": "Figma Personal Access Token",
          "type": "password",
          "placeholder": "figd_xxxxxxxxxxxx",
          "required": false,
          "secret": true,
          "envKey": "FIGMA_TOKEN",
          "envKeyFrom": "figma.tokenEnvVar",
          "aiHint": "Figma personal access token"
        }
      ]
    },
    {
      "id": "knowledge-base",
      "title": "قاعدة المعرفة",
      "titleEn": "Knowledge Base",
      "description": "إعدادات الـ Knowledge Base لخطوات kb: وأمر /ask-kb",
      "descriptionEn": "Knowledge Base (KB Ask) settings for kb: steps and /ask-kb",
      "icon": "📚",
      "group": "project",
      "target": "config/project.json",
      "optional": true,
      "fields": [
        {
          "key": "kb.baseUrl",
          "label": "Base URL",
          "labelEn": "Base URL",
          "type": "url",
          "placeholder": "http://localhost:3000",
          "required": false,
          "hint": "عنوان سيرفر الـ KB Ask API (الهوست فقط، من غير مسار)",
          "aiHint": "knowledge base (KB Ask) API base URL"
        },
        {
          "key": "kb.project",
          "label": "اسم مشروع الـ KB",
          "labelEn": "KB Project",
          "type": "text",
          "placeholder": "my-kb-project",
          "required": false,
          "aiHint": "knowledge base project name"
        },
        {
          "key": "kb.key",
          "label": "KB Ask API Key",
          "type": "password",
          "placeholder": "المفتاح السري المرسل في x-api-key",
          "required": false,
          "secret": true,
          "envKey": "KB_ASK_API_KEY",
          "aiHint": "KB Ask API shared secret key"
        }
      ]
    },
    {
      "id": "environments",
      "title": "إدارة البيئات",
      "titleEn": "Environments",
      "description": "كل بيئات المشروع في مكان واحد — افتح بيئة للتعديل، أو أضف بيئة جديدة، أو أعد التسمية أو احذف (بتأكيد صريح قبل أي تغيير في الملفات)",
      "descriptionEn": "All project environments — open one to edit, add a new one, rename, or delete (explicit confirmation before any file change)",
      "icon": "🗂️",
      "group": "environment",
      "type": "env-manager"
    },
    {
      "id": "environment",
      "title": "بيئة الاختبار",
      "titleEn": "Test Environment",
      "description": "اسم البيئة ورابط التطبيق وإعدادات الجلسة",
      "descriptionEn": "Environment name, app URL, and session defaults",
      "icon": "🌐",
      "group": "environment",
      "target": "environments/{envName}.json",
      "defaultsSection": true,
      "fields": [
        {
          "key": "envName",
          "label": "اسم البيئة (اسم الملف)",
          "labelEn": "Environment Name",
          "type": "text",
          "placeholder": "qc",
          "default": "qc",
          "required": true,
          "readonly": true,
          "pattern": "^[a-z0-9][a-z0-9_-]{0,30}$",
          "patternMsg": "حروف إنجليزية صغيرة وأرقام و - أو _ فقط (بحد أقصى 31 حرفاً) — يصبح اسم ملف",
          "aiHint": "environment name being configured (e.g. qc, staging, uat)",
          "hint": "دي البيئة المفتوحة حالياً. تغيير الاسم بيتم من صفحة إدارة البيئات (إعادة تسمية) — بتأكيد صريح، مش بالكتابة هنا."
        },
        {
          "key": "portalUrl",
          "label": "رابط التطبيق (Portal URL)",
          "labelEn": "Portal URL",
          "type": "url",
          "placeholder": "https://app.example.com",
          "required": true,
          "aiHint": "application URL, portal URL, base URL for testing"
        }
      ]
    },
    {
      "id": "test-users",
      "title": "مستخدمو الاختبار",
      "titleEn": "Test Users",
      "description": "بيانات الحسابات المستخدمة في الاختبارات — حقول المستخدم قابلة للتخصيص ومشتركة بين كل البيئات",
      "descriptionEn": "Test account data — the field set is customizable and shared across all environments",
      "icon": "👥",
      "group": "environment",
      "target": "environments/{envName}.json",
      "type": "dynamic-list",
      "listKey": "users",
      "minItems": 1,
      "defaults": [
        {
          "handle": "valid_user",
          "phone": "",
          "role": "customer"
        },
        {
          "handle": "expired_user",
          "phone": "",
          "notes": "for negative login scenarios"
        }
      ]
    },
    {
      "id": "db-connection",
      "title": "قاعدة البيانات",
      "titleEn": "Database Connection",
      "description": "إعدادات الاتصال بقاعدة البيانات لخطوات db:",
      "descriptionEn": "Database connection settings for db: steps",
      "icon": "🗄️",
      "group": "environment",
      "target": "environments/{envName}.json",
      "optional": true,
      "fields": [
        {
          "key": "db.server",
          "label": "Server",
          "type": "text",
          "placeholder": "localhost",
          "required": false,
          "aiHint": "database server hostname or IP"
        },
        {
          "key": "db.port",
          "label": "Port",
          "type": "number",
          "placeholder": "1433",
          "default": 1433,
          "required": false,
          "aiHint": "database port number"
        },
        {
          "key": "db.name",
          "label": "اسم قاعدة البيانات",
          "labelEn": "Database Name",
          "type": "text",
          "placeholder": "my-database",
          "required": false,
          "aiHint": "database name"
        },
        {
          "key": "db.user",
          "label": "المستخدم",
          "labelEn": "Username",
          "type": "text",
          "placeholder": "qa_user",
          "required": false,
          "aiHint": "database username"
        },
        {
          "key": "db.passwordEnvVar",
          "label": "متغير كلمة المرور",
          "labelEn": "Password Env Var",
          "type": "text",
          "placeholder": "SQLCMDPASSWORD",
          "default": "SQLCMDPASSWORD",
          "required": false,
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "patternMsg": "اسم متغير بيئة صالح فقط: حروف إنجليزية وأرقام و _ بدون مسافات",
          "aiHint": "environment variable name for DB password"
        },
        {
          "key": "db.password",
          "label": "كلمة مرور قاعدة البيانات",
          "type": "password",
          "placeholder": "••••••••",
          "required": false,
          "secret": true,
          "envKey": "SQLCMDPASSWORD",
          "envKeyFrom": "db.passwordEnvVar",
          "aiHint": "database password"
        }
      ]
    },
    {
      "id": "api-integration",
      "title": "API Integration",
      "titleEn": "API Integration",
      "description": "إعدادات الـ REST API لخطوات api:",
      "descriptionEn": "REST API settings for api: steps",
      "icon": "🔌",
      "group": "environment",
      "target": "environments/{envName}.json",
      "optional": true,
      "fields": [
        {
          "key": "api.baseUrl",
          "label": "Base URL",
          "type": "url",
          "placeholder": "https://api.example.com",
          "required": false,
          "aiHint": "API base URL"
        },
        {
          "key": "api.tokenEnvVar",
          "label": "متغير الـ Token",
          "labelEn": "Token Env Var",
          "type": "text",
          "placeholder": "API_TOKEN",
          "default": "API_TOKEN",
          "required": false,
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "patternMsg": "اسم متغير بيئة صالح فقط: حروف إنجليزية وأرقام و _ بدون مسافات",
          "aiHint": "environment variable name for API bearer token"
        },
        {
          "key": "api.token",
          "label": "API Token",
          "type": "password",
          "placeholder": "Bearer xxxxxxxxxxxx",
          "required": false,
          "secret": true,
          "envKey": "API_TOKEN",
          "envKeyFrom": "api.tokenEnvVar",
          "aiHint": "API bearer token"
        }
      ]
    },
    {
      "id": "review",
      "title": "مراجعة وحفظ",
      "titleEn": "Review & Save",
      "description": "راجع الملفات اللي هتتكتب قبل الحفظ",
      "descriptionEn": "Review the files to be written before saving",
      "icon": "✅",
      "type": "review",
      "outputs": [
        {
          "file": "config/project.json",
          "key": "projectConfig"
        },
        {
          "file": "environments/{envName}.json",
          "key": "envConfig"
        }
      ]
    }
  ]
}
