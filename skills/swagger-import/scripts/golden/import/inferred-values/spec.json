{
  "openapi": "3.0.0",
  "info": {
    "title": "Pet Store"
  },
  "servers": [
    {
      "url": "https://p.example.test"
    }
  ],
  "paths": {
    "/pets/{id}": {
      "get": {
        "operationId": "getPet",
        "responses": {
          "200": {
            "description": "ok"
          }
        },
        "parameters": [
          {
            "name": "id",
